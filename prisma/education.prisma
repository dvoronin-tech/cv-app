model Education {
  id          String    @id @default(cuid())
  name        String
  description String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  @@unique([profileId, name, startDate])
  @@index([profileId])
}
