enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Skill {
  id          String     @id @default(cuid())
  name        String
  description String?
  level       SkillLevel

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  @@index([profileId])
}
